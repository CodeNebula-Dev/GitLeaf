{
  "name": "gitleaf",
  "version": "0.1.0",
  "description": "The open-source, local-first, collaborative LaTeX platform",
  "type": "module",
  "bin": {
    "gitleaf": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"green,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc && vite build",
    "cli": "tsx src/cli/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@types/pdfkit": "^0.17.6",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "monaco-editor": "^0.52.2",
    "nanoid": "^5.0.9",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.19.1",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.18.0",
    "y-monaco": "^0.1.6",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.23"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "keywords": [
    "latex",
    "overleaf-alternative",
    "local-first",
    "crdt",
    "collaboration",
    "git",
    "editor"
  ],
  "author": "CodeNebula-Dev",
  "license": "MIT"
}
